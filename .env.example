# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Neon) ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- LLM ---
ANTHROPIC_API_KEY=

# --- TTS / Tokenizer (Render) ---
VOICEVOX_BASE_URL=https://your-voicevox.onrender.com
VOICEVOX_SPEAKER_ID=3
SUDACHI_BASE_URL=https://your-sudachi.onrender.com

# --- STT (Phase 2+) ---
OPENAI_API_KEY=

# --- Email ---
RESEND_API_KEY=
RESEND_FROM=kotoba@yourdomain.com
DAILY_DIGEST_TO=you@yourdomain.com

# --- Cron ---
CRON_SECRET=long-random-string

# --- Storage for generated audio (S3-compatible or local fallback) ---
AUDIO_STORAGE_DIR=./.audio
PUBLIC_AUDIO_BASE_URL=http://localhost:3000/audio
